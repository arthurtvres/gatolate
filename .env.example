# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
#
# VITE_SUPABASE_URL → https://<código-do-projeto>.supabase.co
#   (o código aparece na URL do painel: supabase.com/dashboard/project/<código>)
#
# VITE_SUPABASE_ANON_KEY → Project Settings → API Keys → "Publishable key"
#   (começa com sb_publishable_...). A antiga chave "anon" também funciona.
#   ⚠️ NUNCA use a "Secret key" (sb_secret_...): ela ignora a segurança do banco.
#
# Sem essas chaves o site funciona em "modo demonstração": produtos do
# src/config/loja.js, pedidos não são registrados e o /admin fica indisponível.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_cole-aqui
